<?xml version="1.0" encoding="UTF-8"?>
<CATS version="1.11">
<Problem title="Hello, World!" lang="en" tlimit="1" mlimit="64"
  inputFile="*STDIN" outputFile="*STDOUT">

<ProblemStatement>
<p>Print the line <code>Hello, World!</code>.</p>
<p>This problem exists to smoke-test the judge: every supported language
should be able to solve it.</p>
</ProblemStatement>

<InputFormat>
<p>The input contains arbitrary text, which should be ignored.</p>
</InputFormat>

<OutputFormat>
<p>Output exactly one line: <code>Hello, World!</code></p>
</OutputFormat>

<Checker name="check" src="check.py" style="testlib"/>
<!-- The same program in every language the judges run; de_code is explicit
     because extensions are ambiguous (.cpp is MS Visual C++, .py both Python and PyPy). -->
<Solution name="hello_c" src="sol/hello.c" de_code="105"/>
<Solution name="hello_cpp" src="sol/hello.cc" de_code="102"/>
<Solution name="hello_fpc" src="sol/hello.pp" de_code="202"/>
<Solution name="hello_delphi" src="sol/hello.dpr" de_code="204"/>
<Solution name="hello_go" src="sol/hello.go" de_code="404"/>
<Solution name="hello_perl" src="sol/hello.pl" de_code="501"/>
<Solution name="hello_python" src="sol/hello.py" de_code="502"/>
<Solution name="hello_pypy" src="sol/hello_pypy.py" de_code="510"/>

<Test rank="1-3"><In src="%0n.in"/><Out src="%0n.ans"/></Test>

<Sample rank="1">
<SampleIn src="01.in"/>
<SampleOut src="01.ans"/>
</Sample>

</Problem>
</CATS>
